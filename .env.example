# ==========================================
# TripMate AI - Environment Configuration Template
# ==========================================

# 1. PostgreSQL Database URL (Required for LangGraph state persistence)
# e.g., Supabase Session Pooler / Neon / Render / Local Postgres:
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# 2. LLM Provider Configuration
# Options: 'groq' (cloud) or 'ollama' (local)
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here

# Local Ollama Settings (if LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_GPU=0

# 3. Tavily API Key (Required for Hotel & Destination Web Search)
# Get free key from: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# 4. AviationStack API Key (Required for Live Flight Search)
# Get free key from: https://aviationstack.com
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# 5. Default Origin Airport (IATA Code)
# e.g., DEL (Delhi), BOM (Mumbai), BLR (Bangalore), DAC (Dhaka), JFK (New York)
DEFAULT_ORIGIN_IATA=DEL
